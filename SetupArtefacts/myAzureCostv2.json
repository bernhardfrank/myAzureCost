{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "_artifactsLocation": {
            "type": "string",
            "defaultValue": "https://raw.githubusercontent.com/bernhardfrank/myAzureCost/masterV2/SetupArtefacts/",
            "metadata": {
                "description": "URI to artifacts location"
            }
        },
        "_artifactsLocationSasToken": {
            "type": "securestring",
            "defaultValue": "",
            "metadata": {
                "description": "The sasToken required to access _artifactsLocation.  When the template is deployed using the accompanying scripts, a sasToken will be automatically generated"
            }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "The location into which all resources should be deployed."
            }
        },
        "datalocation": {
            "type": "string",
            "defaultValue": "Europe",
            "allowedValues": [
                "Europe",
                "UnitedStates",
                "UK",
                "Australia",
                "AsiaPacific",
                "Brazil",
                "Canada",
                "Germany",
                "France",
                "Africa",
                "India",
                "Japan",
                "Korea",
                "UAE",
                "Switzerland",
                "Norway"
            ],
            "metadata": {
                "description": "The datalocation for the Communication Services resource. This is the location where the data will be stored and processed."
            }
        },
        "baseTime": {
            "type": "string",
            "defaultValue": "[utcnow('yyyy-MM-dd T00:00:00')]"
        },
        "myAzureCostCultureInfo": {
            "type": "string",
            "defaultValue": "de-DE",
            "metadata": {
                "description": "The culture info string e.g. 'de-DE' used for encoding .csv attached to email"
            }
        }
    },
    "variables": {
        "automationAccounts_aa_myazurecost_name": "aa-myazurecost",
        "emailServices_mailsvc_myazurecost_name": "mailsvc-myazurecost",
        "communicationServices_acs_myazurecost_bfrank_name": "[concat('cs-', parameters('automationAccounts_aa_myazurecost_name'), substring(uniqueString(subscription().subscriptionId), 0, 4))]",
        "AA": {
            "runbooks": [
                {
                    "name": "RunBk_MyAzureCost",
                    "url": "[concat(parameters('_artifactsLocation'), '/RunBk_MyAzureCost.ps1', parameters('_artifactsLocationSasToken'))]",
                    "version": "2.0.0.0",
                    "type": "PowerShell",
                    "description": "Runbook to gather azure consumption of the day.",
                    "linkedToSchedule": "daily"
                }
            ],
            "modules": [],
            "schedules": [
                {
                    "name": "daily",
                    "startTime": "[dateTimeAdd(parameters('baseTime'),'P1DT8H30M')]",
                    "expiryTime": "9999-12-31T23:59:59.9999999+00:00",
                    "interval": 1,
                    "frequency": "Day",
                    "timeZone": "UTC"
                }
            ]
        }
    },
    "resources": [
        {
            "type": "Microsoft.Automation/automationAccounts",
            "apiVersion": "2024-10-23",
            "name": "[variables('automationAccounts_aa_myazurecost_name')]",
            "location": "[parameters('location')]",
            "identity": {
                "type": "SystemAssigned"
            },
            "properties": {
                "disableLocalAuth": false,
                "sku": {
                    "name": "Basic"
                },
                "encryption": {
                    "keySource": "Microsoft.Automation",
                    "identity": {}
                }
            }
        },
        {
            "type": "Microsoft.Communication/emailServices",
            "apiVersion": "2026-03-18",
            "name": "[variables('emailServices_mailsvc_myazurecost_name')]",
            "location": "global",
            "properties": {
                "dataLocation": "[parameters('datalocation')]"
            }
        },
        {
            "type": "Microsoft.Automation/automationAccounts/connectionTypes",
            "apiVersion": "2024-10-23",
            "name": "[concat(variables('automationAccounts_aa_myazurecost_name'), '/Azure')]",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts', variables('automationAccounts_aa_myazurecost_name'))]"
            ],
            "properties": {
                "isGlobal": true,
                "fieldDefinitions": {
                    "AutomationCertificateName": {
                        "isEncrypted": false,
                        "isOptional": false,
                        "type": "System.String"
                    },
                    "SubscriptionID": {
                        "isEncrypted": false,
                        "isOptional": false,
                        "type": "System.String"
                    }
                }
            }
        },
        {
            "type": "Microsoft.Automation/automationAccounts/connectionTypes",
            "apiVersion": "2024-10-23",
            "name": "[concat(variables('automationAccounts_aa_myazurecost_name'), '/AzureClassicCertificate')]",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts', variables('automationAccounts_aa_myazurecost_name'))]"
            ],
            "properties": {
                "isGlobal": true,
                "fieldDefinitions": {
                    "SubscriptionName": {
                        "isEncrypted": false,
                        "isOptional": false,
                        "type": "System.String"
                    },
                    "SubscriptionId": {
                        "isEncrypted": false,
                        "isOptional": false,
                        "type": "System.String"
                    },
                    "CertificateAssetName": {
                        "isEncrypted": false,
                        "isOptional": false,
                        "type": "System.String"
                    }
                }
            }
        },
        {
            "type": "Microsoft.Automation/automationAccounts/connectionTypes",
            "apiVersion": "2024-10-23",
            "name": "[concat(variables('automationAccounts_aa_myazurecost_name'), '/AzureServicePrincipal')]",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts', variables('automationAccounts_aa_myazurecost_name'))]"
            ],
            "properties": {
                "isGlobal": true,
                "fieldDefinitions": {
                    "ApplicationId": {
                        "isEncrypted": false,
                        "isOptional": false,
                        "type": "System.String"
                    },
                    "TenantId": {
                        "isEncrypted": false,
                        "isOptional": false,
                        "type": "System.String"
                    },
                    "CertificateThumbprint": {
                        "isEncrypted": false,
                        "isOptional": false,
                        "type": "System.String"
                    },
                    "SubscriptionId": {
                        "isEncrypted": false,
                        "isOptional": false,
                        "type": "System.String"
                    }
                }
            }
        },
        {
            "type": "Microsoft.Automation/automationAccounts/jobs",
            "apiVersion": "2024-10-23",
            "name": "[concat(variables('automationAccounts_aa_myazurecost_name'), '/60754b1f-3eec-42fb-bcb6-34b679d52d70')]",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts', variables('automationAccounts_aa_myazurecost_name'))]"
            ],
            "properties": {
                "runbook": {
                    "name": "RunBk_MyAzureCost"
                }
            }
        },
        {
            "type": "Microsoft.Automation/automationAccounts/jobSchedules",
            "apiVersion": "2024-10-23",
            "name": "[concat(variables('automationAccounts_aa_myazurecost_name'), '/5c478ab8-df7a-4493-9f42-cacef8744523')]",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts', variables('automationAccounts_aa_myazurecost_name'))]"
            ],
            "properties": {
                "runbook": {
                    "name": "RunBk_MyAzureCost"
                },
                "schedule": {
                    "name": "Daily-MyAzureCost"
                }
            }
        },
        {
            "type": "Microsoft.Automation/automationAccounts/runbooks",
            "apiVersion": "2024-10-23",
            "name": "[concat(variables('automationAccounts_aa_myazurecost_name'), '/RunBk_MyAzureCost')]",
            "location": "westeurope",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts', variables('automationAccounts_aa_myazurecost_name'))]"
            ],
            "properties": {
                "runbookType": "PowerShell",
                "logVerbose": false,
                "logProgress": false,
                "logActivityTrace": 0
            }
        },
        {
            "type": "Microsoft.Automation/automationAccounts/schedules",
            "apiVersion": "2024-10-23",
            "name": "[concat(variables('automationAccounts_aa_myazurecost_name'), '/Daily-MyAzureCost')]",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts', variables('automationAccounts_aa_myazurecost_name'))]"
            ],
            "properties": {
                "description": "Daily AzureCost Report",
                "startTime": "[dateTimeAdd(utcNow('d'), 'P1DT9H30M')]",
                "expiryTime": "9999-12-31T23:59:59.9999999+00:00",
                "interval": 1,
                "frequency": "Day",
                "timeZone": "Etc/UTC"
            }
        },
        {
            "type": "Microsoft.Communication/communicationServices",
            "apiVersion": "2026-03-18",
            "name": "[variables('communicationServices_acs_myazurecost_bfrank_name')]",
            "location": "global",
            "dependsOn": [
                "[resourceId('Microsoft.Communication/emailServices/domains', variables('emailServices_mailsvc_myazurecost_name'), 'AzureManagedDomain')]"
            ],
            "identity": {
                "type": "None"
            },
            "properties": {
                "dataLocation": "[variables('datalocation')]",
                "linkedDomains": [
                    "[resourceId('Microsoft.Communication/emailServices/domains', variables('emailServices_mailsvc_myazurecost_name'), 'AzureManagedDomain')]"
                ]
            }
        },
        {
            "type": "Microsoft.Communication/emailServices/domains",
            "apiVersion": "2026-03-18",
            "name": "[concat(variables('emailServices_mailsvc_myazurecost_name'), '/AzureManagedDomain')]",
            "location": "global",
            "dependsOn": [
                "[resourceId('Microsoft.Communication/emailServices', variables('emailServices_mailsvc_myazurecost_name'))]"
            ],
            "properties": {
                "domainManagement": "AzureManaged",
                "userEngagementTracking": "Disabled"
            }
        },
        {
            "type": "microsoft.communication/emailservices/domains/senderusernames",
            "apiVersion": "2026-03-18",
            "name": "[concat(variables('emailServices_mailsvc_myazurecost_name'), '/azuremanageddomain/donotreply')]",
            "dependsOn": [
                "[resourceId('microsoft.communication/emailservices/domains', variables('emailServices_mailsvc_myazurecost_name'), 'azuremanageddomain')]",
                "[resourceId('microsoft.communication/emailservices', variables('emailServices_mailsvc_myazurecost_name'))]"
            ],
            "properties": {
                "username": "DoNotReply",
                "displayName": "DoNotReply"
            }
        }
    ]
}