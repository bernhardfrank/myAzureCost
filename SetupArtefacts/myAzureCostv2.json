{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "_artifactsLocation": {
            "type": "string",
            "defaultValue": "https://raw.githubusercontent.com/bernhardfrank/myAzureCost/masterV2/SetupArtefacts/",
            "metadata": {
                "description": "URI to artifacts location"
            }
        },
        "_artifactsLocationSasToken": {
            "type": "securestring",
            "defaultValue": "",
            "metadata": {
                "description": "The sasToken required to access _artifactsLocation.  When the template is deployed using the accompanying scripts, a sasToken will be automatically generated"
            }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "The location into which all resources should be deployed."
            }
        },
        "datalocation": {
            "type": "string",
            "defaultValue": "Europe",
            "allowedValues": [
                "Europe",
                "UnitedStates",
                "UK",
                "Australia",
                "AsiaPacific",
                "Brazil",
                "Canada",
                "Germany",
                "France",
                "Africa",
                "India",
                "Japan",
                "Korea",
                "UAE",
                "Switzerland",
                "Norway"
            ],
            "metadata": {
                "description": "The datalocation for the Communication Services resource. This is the location where the data will be stored and processed."
            }
        },
        "baseTime": {
            "type": "string",
            "defaultValue": "[utcnow('yyyy-MM-dd T00:00:00')]"
        },
        "AzureCostCultureInfo": {
            "type": "string",
            "defaultValue": "de-DE",
            "metadata": {
                "description": "The culture info string e.g. 'de-DE' used for encoding .csv attached to email"
            }
        },
        "RecipientEmail": {
            "type": "string",
            "defaultValue": "xyz@contoso.com",
            "metadata": {
                "description": "Please provide the email address to which the consumption report will be sent. This email address will be used as the recipient of the daily consumption report."
            }
        },
        "AASku": {
            "type": "string",
            "defaultValue": "Free",
            "metadata": {
                "description": "The SKU for the Azure Automation Account. Choose 'Free' for the free tier or 'Basic' for the basic tier."
            },
            "allowedValues": [
                "Free",
                "Basic"
            ]
        }
    },
    "variables": {
        "automationAccountName": "[concat('aa-myazurecost', substring(guid(resourceGroup().id), 0, 4))]",
        "myAzureCostStorageAccountName": "[concat('samyazurecost',substring(uniqueString(resourceGroup().id),0,4))]",
        "emailServicesName": "mailsvc-myazurecost",
        "communicationServicesName": "[concat('cs-', variables('automationAccountName'), substring(uniqueString(subscription().subscriptionId), 0, 4))]",
        "AAVariables": [
            {
                "name": "SubscriptionId",
                "description": "Azure subscription Id",
                "value": "[concat('\"',subscription().subscriptionId,'\"')]",
                "isEncrypted": false
            },
            {
                "name": "RecipientEmail",
                "description": "The email address the consumption is sent to",
                "value": "[concat('\"',parameters('RecipientEmail'),'\"')]",
                "isEncrypted": false
            },
            {
                "name": "CultureInfo",
                "description": "The culture info string e.g. 'de-DE' used for encoding .csv attached to email",
                "value": "[concat('\"',parameters('AzureCostCultureInfo'),'\"')]",
                "isEncrypted": false
            },
            {
                "name": "LookbackDays",
                "description": "The number of days to look back for consumption data",
                "value": "7",
                "isEncrypted": false
            },
            {
                "name": "MyAzureCostStorageAccountName",
                "description": "The storage account used for storage of consumption .csv files",
                "value": "[concat('\"',variables('myAzureCostStorageAccountName'),'\"')]",
                "isEncrypted": false
            }
        ],
        "AA": {
            "runbooks": [
                {
                    "name": "RunBk_MyAzureCost",
                    "url": "[concat(parameters('_artifactsLocation'), 'RunBk_MyAzureCost.ps1', parameters('_artifactsLocationSasToken'))]",
                    "version": "1.0.0.0",
                    "type": "PowerShell",
                    "description": "Runbook to gather azure consumption of the day.",
                    "linkedToSchedule": "daily"
                },
                {
                    "name": "RunBk_SendDailyCostDetailsReport",
                    "url": "[concat(parameters('_artifactsLocation'), 'RunBk_SendDailyCostDetailsReport.ps1', parameters('_artifactsLocationSasToken'))]",
                    "version": "1.0.0.0",
                    "type": "PowerShell72",
                    "description": "Runbook to gather azure consumption of the day.",
                    "linkedToSchedule": "daily"
                }
            ],
            "schedules": [
                {
                    "name": "daily",
                    "startTime": "[dateTimeAdd(parameters('baseTime'),'P1DT8H30M')]",
                    "expiryTime": "9999-12-31T23:59:59.9999999+00:00",
                    "interval": 1,
                    "frequency": "Day",
                    "timeZone": "UTC"
                }
            ]
        }
    },
    "resources": [
        {
            "type": "Microsoft.Storage/storageAccounts",
            "apiVersion": "2026-06-01",
            "name": "[variables('myAzureCostStorageAccountName')]",
            "location": "[resourceGroup().location]",
            "sku": {
                "name": "Standard_LRS",
                "tier": "Standard"
            },
            "kind": "StorageV2",
            "properties": {
                "accessTier": "Cold"
            },
            "resources": [
                {
                    "name": "default/myazurecostcontainer",
                    "type": "blobServices/containers",
                    "apiVersion": "2026-06-01",
                    "dependsOn": [
                        "[variables('myAzureCostStorageAccountName')]"
                    ]
                },
                {
                    "name": "default/myazurecosttable",
                    "type": "tableServices/tables",
                    "apiVersion": "2026-06-01",
                    "dependsOn": [
                        "[variables('myAzureCostStorageAccountName')]"
                    ]
                }
            ]
        },
        {
            "type": "Microsoft.Automation/automationAccounts",
            "apiVersion": "2024-10-23",
            "name": "[variables('automationAccountName')]",
            "location": "[parameters('location')]",
            "identity": {
                "type": "SystemAssigned"
            },
            "properties": {
                "disableLocalAuth": false,
                "sku": {
                    "name": "[parameters('AASku')]"
                },
                "encryption": {
                    "keySource": "Microsoft.Automation",
                    "identity": {}
                }
            }
        },
        {
            "name": "[concat(variables('automationAccountName'), '/',variables('AAVariables')[copyIndex()].name)]",
            "type": "Microsoft.Automation/automationAccounts/variables",
            "apiVersion": "2024-10-23",
            "location": "[resourceGroup().location]",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts/', variables('automationAccountName'))]"
            ],
            "copy": {
                "name": "variablescopy",
                "count": "[length(variables('AAVariables'))]",
                "mode": "Serial"
            },
            "properties": {
                "description": "[variables('AAVariables')[copyIndex()].description]",
                "value": "[variables('AAVariables')[copyIndex()].value]",
                "isEncrypted": "[variables('AAVariables')[copyIndex()].isEncrypted]"
            }
        },
        {
            "type": "Microsoft.Automation/automationAccounts/schedules",
            "apiVersion": "2024-10-23",
            "name": "[concat(variables('automationAccountName'), '/',variables('AA').schedules[copyIndex()].name)]",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts', variables('automationAccountName'))]"
            ],
            "copy": {
                "name": "schedulescopy",
                "count": "[length(variables('AA').schedules)]"
            },
            "properties": {
                "startTime": "[variables('AA').schedules[copyIndex()].startTime]",
                "expiryTime": "[variables('AA').schedules[copyIndex()].expiryTime]",
                "interval": "[variables('AA').schedules[copyIndex()].interval]",
                "frequency": "[variables('AA').schedules[copyIndex()].frequency]",
                "timeZone": "[variables('AA').schedules[copyIndex()].timeZone]"
            }
        },
        {
            "type": "Microsoft.Automation/automationAccounts/runbooks",
            "apiVersion": "2024-10-23",
            "name": "[concat(variables('automationAccountName'), '/', variables('AA').runbooks[copyIndex()].Name)]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts', variables('automationAccountName'))]"
            ],
            "copy": {
                "name": "runbooksLoop",
                "count": "[length(variables('AA').runbooks)]"
            },
            "properties": {
                "description": "[variables('AA').runbooks[copyIndex()].description]",
                "runbookType": "[variables('AA').runbooks[copyIndex()].type]",
                "logProgress": false,
                "logVerbose": true,
                "publishContentLink": {
                    "uri": "[variables('AA').runbooks[copyIndex()].url]",
                    "version": "[variables('AA').runbooks[copyIndex()].version]"
                }
            }
        },
        {
            "type": "Microsoft.Automation/automationAccounts/jobSchedules",
            "apiVersion": "2024-10-23",
            "name": "[concat(variables('automationAccountName'), '/',guid(concat(string(copyIndex()),parameters('baseTime')),variables('automationAccountName')))]",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts', variables('automationAccountName'))]",
                "runbooksLoop",
                "schedulescopy"
            ],
            "condition": "[not(empty(variables('AA').runbooks[copyIndex()].linkedToSchedule))]",
            "copy": {
                "name": "jobSchedules",
                "count": "[length(variables('AA').runbooks)]"
            },
            "properties": {
                "runbook": {
                    "name": "[variables('AA').runbooks[copyIndex()].name]"
                },
                "schedule": {
                    "name": "[variables('AA').runbooks[copyIndex()].linkedToSchedule]"
                }
            }
        },
        {
            "type": "Microsoft.Communication/emailServices",
            "apiVersion": "2026-03-18",
            "name": "[variables('emailServicesName')]",
            "location": "global",
            "properties": {
                "dataLocation": "[parameters('datalocation')]"
            }
        },
        {
            "type": "Microsoft.Communication/communicationServices",
            "apiVersion": "2026-03-18",
            "name": "[variables('communicationServicesName')]",
            "location": "global",
            "dependsOn": [
                "[resourceId('Microsoft.Communication/emailServices/domains', variables('emailServicesName'), 'AzureManagedDomain')]"
            ],
            "identity": {
                "type": "None"
            },
            "properties": {
                "dataLocation": "[parameters('datalocation')]",
                "linkedDomains": [
                    "[resourceId('Microsoft.Communication/emailServices/domains', variables('emailServicesName'), 'AzureManagedDomain')]"
                ]
            }
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(resourceId('Microsoft.Communication/communicationServices', variables('communicationServicesName')), variables('automationAccountName'), 'Contributor')]",
            "scope": "[format('Microsoft.Communication/communicationServices/{0}', variables('communicationServicesName'))]",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts', variables('automationAccountName'))]",
                "[resourceId('Microsoft.Communication/communicationServices', variables('communicationServicesName'))]"
            ],
            "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b24988ac-6180-42a0-ab88-20f7382dd24c')]",
                "principalId": "[reference(resourceId('Microsoft.Automation/automationAccounts', variables('automationAccountName')), '2024-10-23', 'Full').identity.principalId]",
                "principalType": "ServicePrincipal"
            }
        },
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2022-09-01",
            "name": "costManagementReaderRoleAssignment",
            "location": "[parameters('location')]",
            "subscriptionId": "[subscription().subscriptionId]",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts', variables('automationAccountName'))]"
            ],
            "properties": {
                "mode": "Incremental",
                "expressionEvaluationOptions": {
                    "scope": "inner"
                },
                "parameters": {
                    "principalId": {
                        "value": "[reference(resourceId('Microsoft.Automation/automationAccounts', variables('automationAccountName')), '2024-10-23', 'Full').identity.principalId]"
                    }
                },
                "template": {
                    "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "principalId": {
                            "type": "string"
                        }
                    },
                    "resources": [
                        {
                            "type": "Microsoft.Authorization/roleAssignments",
                            "apiVersion": "2022-04-01",
                            "name": "[guid(subscription().id, parameters('principalId'), '72fafb9e-0641-4937-9268-a91bfd8191a3')]",
                            "properties": {
                                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '72fafb9e-0641-4937-9268-a91bfd8191a3')]",
                                "principalId": "[parameters('principalId')]",
                                "principalType": "ServicePrincipal"
                            }
                        }
                    ]
                }
            }
        },
        {
            "type": "Microsoft.Communication/emailServices/domains",
            "apiVersion": "2026-03-18",
            "name": "[concat(variables('emailServicesName'), '/AzureManagedDomain')]",
            "location": "global",
            "dependsOn": [
                "[resourceId('Microsoft.Communication/emailServices', variables('emailServicesName'))]"
            ],
            "properties": {
                "domainManagement": "AzureManaged",
                "userEngagementTracking": "Disabled"
            }
        },
        {
            "type": "microsoft.communication/emailservices/domains/senderusernames",
            "apiVersion": "2026-03-18",
            "name": "[concat(variables('emailServicesName'), '/azuremanageddomain/donotreply')]",
            "dependsOn": [
                "[resourceId('microsoft.communication/emailservices/domains', variables('emailServicesName'), 'azuremanageddomain')]",
                "[resourceId('microsoft.communication/emailservices', variables('emailServicesName'))]"
            ],
            "properties": {
                "username": "DoNotReply",
                "displayName": "DoNotReply"
            }
        },
        {
            "name": "[concat(variables('automationAccountName'), '/','SenderAddress')]",
            "type": "Microsoft.Automation/automationAccounts/variables",
            "apiVersion": "2024-10-23",
            "location": "[resourceGroup().location]",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts', variables('automationAccountName'))]",
                "[resourceId('microsoft.communication/emailservices/domains', variables('emailServicesName'), 'azuremanageddomain')]"
            ],
            "properties": {
                "description": "The sender's email server address",
                "value": "[concat('\"','DoNotReply@', reference(resourceId('Microsoft.Communication/emailServices/domains', variables('emailServicesName'), 'AzureManagedDomain'), '2026-03-18').fromSenderDomain, '\"')]",
                "isEncrypted": false
            }
        },
        {
            "name": "[concat(variables('automationAccountName'), '/','AcsEndpoint')]",
            "type": "Microsoft.Automation/automationAccounts/variables",
            "apiVersion": "2024-10-23",
            "location": "[resourceGroup().location]",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts', variables('automationAccountName'))]",
                "[resourceId('microsoft.communication/emailservices', variables('emailServicesName'))]"
            ],
            "properties": {
                "description": "The sender's email server secure ssl port to connect to",
                "value": "[concat('\"', 'https://',reference(resourceId('Microsoft.Communication/communicationServices', variables('communicationServicesName')), '2026-03-18').hostName, '\"')]",
                "isEncrypted": false
            }
        }
    ],
    "outputs": {
        "hostName": {
            "type": "string",
            "value": "[reference(resourceId('Microsoft.Communication/communicationServices', variables('communicationServicesName')), '2026-03-18').hostName]"
        },
        "fromSenderDomain": {
            "type": "string",
            "value": "[reference(resourceId('Microsoft.Communication/emailServices/domains', variables('emailServicesName'), 'AzureManagedDomain'), '2026-03-18').fromSenderDomain]"
        }
    }
}